# DivineCore Technologies — HRMS Backend Environment Variables
# Copy this file to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="mysql://root:your_password@localhost:3306/divinecore_hrms"

# JWT
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_also_very_long_change_this
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:5173

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="DivineCore HRMS <noreply@divinecore.in>"

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Company
COMPANY_NAME="DivineCore Technologies Pvt. Ltd."
COMPANY_TIMEZONE=Asia/Kolkata
WORK_START_TIME=09:00
WORK_END_TIME=18:00
GRACE_PERIOD_MINUTES=15
